{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git tag *)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(* gh pr merge*)",
      "Bash(wrangler deploy *)",
      "Bash(* wrangler deploy *)",
      "Bash(* wrangler deploy)",
      "Bash(wrangler secret *)",
      "Bash(* wrangler secret *)",
      "Bash(* wrangler secret)",
      "Bash(wrangler tail *)",
      "Bash(* wrangler tail *)",
      "Bash(* wrangler tail)",
      "Bash(wrangler hyperdrive *)",
      "Bash(* wrangler hyperdrive *)",
      "Bash(supabase *)",
      "Bash(* supabase *)",
      "Bash(* supabase)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/rules/**)",
      "Edit(~/code/software/rsb/orchestration/agent-box/**)",
      "Edit(/.githooks/**)",
      "Edit(/.git/config)",
      "Bash(*core.hooksPath*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.githooks/agent-guard",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyWrite": [
        ".claude/settings.json",
        ".githooks"
      ]
    }
  },
  "enabledPlugins": {
    "svelte@svelte": true
  }
}
