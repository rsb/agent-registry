#!/bin/sh
# Refuses commit messages that are not Conventional Commits, that
# contain an em dash, or that carry an AI attribution trailer.
# Installed through core.hooksPath (git config core.hooksPath .githooks).

msg_file=$1
fail=0

# The message without git's comment lines.
body=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$body" | grep -m1 -v '^[[:space:]]*$')

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

case $subject in
  "Merge "*|"Revert \""*) ;;
  *)
    if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([^()]+\))?!?: [^[:space:]]"; then
      echo "commit-msg: subject is not a Conventional Commit:" >&2
      echo "  $subject" >&2
      echo "  expected: <type>(<scope>)?: <description>, type one of $types" >&2
      fail=1
    fi
    ;;
esac

if printf '%s\n' "$body" | LC_ALL=C grep -q "$(printf '\342\200\224')"; then
  echo "commit-msg: the message contains an em dash" >&2
  fail=1
fi

if printf '%s\n' "$body" | grep -Eiq '^(co-authored-by|claude-[a-z-]*):|noreply@anthropic\.com|generated with .*claude'; then
  echo "commit-msg: the message carries an AI attribution trailer" >&2
  fail=1
fi

exit $fail
